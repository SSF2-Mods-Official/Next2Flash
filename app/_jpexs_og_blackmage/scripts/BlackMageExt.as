   public class BlackMageExt extends SSF2CharacterExt
   {
      public var specialEvent:* = false;
      
      public var deathProj:*;
      
      private var colTrans:ColorTransform;
      
      private var tintClock:int;
      
      public function BlackMageExt(param1:*)
      {
         super(param1);
      }
      
      override public function initialize() : void
      {
         SSF2API.print("Black Mage initialized.");
         this.addEventListener(SSF2Event.CHAR_KO_DEATH,this.resetChargeOnDeath,{"persistent":true});
         this.colTrans = new ColorTransform();
         this.tintClock = -1;
      }
      
      override public function update() : void
      {
         if(this.getGlobalVariable("BMageNSpecCharge") > 0)
         {
            if(this.tintClock == 0)
            {
               this.colTrans.redOffset = 15 + this.getGlobalVariable("BMageNSpecCharge");
               this.colTrans.greenOffset = 15 + this.getGlobalVariable("BMageNSpecCharge");
               this.colTrans.blueOffset = 15 + this.getGlobalVariable("BMageNSpecCharge");
               this.colTrans.redMultiplier = 1.22;
               this.colTrans.greenMultiplier = 1.22;
               this.colTrans.blueMultiplier = 1.22;
            }
            else if(this.tintClock == 1)
            {
               this.colTrans.redOffset = 8 + this.getGlobalVariable("BMageNSpecCharge") / 2;
               this.colTrans.greenOffset = 8 + this.getGlobalVariable("BMageNSpecCharge") / 2;
               this.colTrans.blueOffset = 8 + this.getGlobalVariable("BMageNSpecCharge") / 2;
               this.colTrans.redMultiplier = 1.11;
               this.colTrans.greenMultiplier = 1.11;
               this.colTrans.blueMultiplier = 1.11;
            }
            else
            {
               this.colTrans.redOffset = 0;
               this.colTrans.greenOffset = 0;
               this.colTrans.blueOffset = 0;
               this.colTrans.redMultiplier = 1;
               this.colTrans.greenMultiplier = 1;
               this.colTrans.blueMultiplier = 1;
            }
            this.getMC().transform.colorTransform = this.colTrans;
            this.tintClock = (this.tintClock + 1) % (9 - Math.floor(this.getGlobalVariable("BMageNSpecCharge") / 1.5));
         }
         else
         {
            this.tintClock = -1;
            if(this.tintClock != -1)
            {
               this.colTrans.redOffset = 0;
               this.colTrans.greenOffset = 0;
               this.colTrans.blueOffset = 0;
               this.colTrans.redMultiplier = 1;
               this.colTrans.greenMultiplier = 1;
               this.colTrans.blueMultiplier = 1;
               this.getMC().transform.colorTransform = this.colTrans;
            }
         }
      }
      
