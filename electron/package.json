{
  "name": "next2flash",
  "version": "1.0.0",
  "description": "Next2Flash — Desktop SWF authoring tool powered by Electron",
  "main": "main.js",
  "author": "Next2Flash",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build-app": "cd ../app && npm run build",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.next2flash.app",
    "productName": "Next2Flash",
    "directories": {
      "output": "../build"
    },
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app",
        "filter": [
          "index.html",
          "editor.html",
          "assets/**/*",
          "as3_decompiler/**/*"
        ]
      },
      {
        "from": "../app/dist/server.exe",
        "to": "server.exe"
      }
    ],
    "win": {
      "target": [
        { "target": "dir", "arch": ["x64"] }
      ]
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
